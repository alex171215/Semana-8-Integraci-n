{
  "name": "semana-8-kong-gateway-bff",
  "version": "1.0.0",
  "description": "Taller Semana 8: Kong Gateway DB-less, Rate-limiting, Trazabilidad y Patr\u00f3n BFF/Aggregator REST+GraphQL en NestJS",
  "author": "alex171215",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "ts-node src/main-unified.ts",
    "start:prod": "node dist/src/main-unified.js",
    "start:productos": "ts-node src/productos-api/main.ts",
    "start:bff": "ts-node src/bff-api/main.ts",
    "start:dev": "ts-node src/main-unified.ts",
    "test": "jest --passWithNoTests --runInBand",
    "test:cov": "jest --coverage",
    "test:rate-limit": "ts-node tests/test-rate-limit.ts",
    "validate:kong": "node -e \"const yaml = require('js-yaml'), fs = require('fs'); yaml.load(fs.readFileSync('kong-gateway/kong.yml', 'utf8')); console.log('kong.yml valido!');\""
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/graphql": "^12.1.0",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}